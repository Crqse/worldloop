{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldloop.dev/schemas/spec_v0.schema.json",
  "title": "WorldLoop ScenarioSpec v0",
  "description": "Schema-driven world definition (main plan §13.2).",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario", "time", "space", "entities", "actions", "termination"],
  "properties": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "scenario_version"],
      "properties": {
        "scenario_id": { "type": "string", "minLength": 1 },
        "scenario_version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "author": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_ticks"],
      "properties": {
        "dt": { "type": "number", "exclusiveMinimum": 0 },
        "max_ticks": { "type": "integer", "minimum": 1 },
        "deterministic": { "type": "boolean" }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["discrete", "continuous", "graph"] },
        "shape": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "bounds": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "node_ids": { "type": "array", "items": { "type": "string" } },
        "edges": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "periodic": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "discrete" } } },
          "then": { "required": ["shape"] }
        },
        {
          "if": { "properties": { "type": { "const": "continuous" } } },
          "then": { "required": ["bounds"] }
        },
        {
          "if": { "properties": { "type": { "const": "graph" } } },
          "then": { "required": ["node_ids"] }
        }
      ]
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "dtype"],
            "properties": {
              "name": { "type": "string" },
              "dtype": { "enum": ["int", "float", "bool"] },
              "shape": { "type": "array", "items": { "type": "integer" } },
              "unit": { "type": "string" }
            }
          }
        }
      }
    },
    "entities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "initial_count"],
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "dtype"],
            "properties": {
              "name": { "type": "string" },
              "dtype": { "enum": ["int", "float", "bool", "str"] }
            }
          }
        },
        "initial_count": { "type": "integer", "minimum": 0 },
        "spawn_template": { "type": "object" }
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "edge_types": { "type": "array", "items": { "type": "string" } },
        "directed": { "type": "boolean" }
      }
    },
    "registries": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "registry_types": { "type": "array", "items": { "type": "string" } },
        "initial_entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entry_id", "registry_type", "state"],
            "additionalProperties": false,
            "properties": {
              "entry_id": { "type": "string", "minLength": 1 },
              "registry_type": { "type": "string", "minLength": 1 },
              "state": { "type": "string", "minLength": 1 },
              "owner_id": { "type": ["string", "null"] },
              "metadata": { "type": "object" },
              "node": { "type": "string" }
            }
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions"],
      "properties": {
        "is_closed": { "type": "boolean" },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["action_type", "effects"],
            "properties": {
              "action_type": { "type": "string", "minLength": 1 },
              "params_schema": { "type": "object" },
              "effects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["target", "op"],
                  "properties": {
                    "target": { "type": "string" },
                    "op": { "enum": ["set", "add", "sub", "mul", "div", "remove", "append"] },
                    "field": { "type": "string" },
                    "value": {}
                  }
                }
              },
              "cost": { "type": "number" },
              "preconditions": { "type": "array" }
            }
          }
        }
      }
    },
    "exogenous": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "events": { "type": "array" },
        "seed": { "type": ["integer", "null"] }
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stop_conditions"],
      "properties": {
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["max_ticks", "no_alive", "threshold", "custom"] },
              "field": { "type": "string" },
              "op": { "enum": ["<", "<=", ">", ">=", "==", "!="] },
              "value": {}
            }
          }
        },
        "truncate_at_max": { "type": "boolean" }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy_hooks": { "type": "array", "items": { "type": "string" } },
        "coverage_hooks": { "type": "array", "items": { "type": "string" } },
        "counterfactual_hooks": { "type": "array", "items": { "type": "string" } },
        "export_hooks": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
